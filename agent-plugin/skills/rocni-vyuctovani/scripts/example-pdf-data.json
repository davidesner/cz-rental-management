      "<b>Nájem:</b> ...",
      "<b>Služby:</b> ...",
      "<b>Elektřina:</b> ...",
      "<b>Platby:</b> ..."
    ]
  },

  "_schema_sheets": "jeden list na kind; type: services | electricity_monthly | payments",
