  "_schema_result": "velký box na straně 1 a na poslední straně",
  "result": {
    "label_p1": "PŘEPLATEK NÁJEMCE",
    "amount_kc": 0.00,
    "subtitle_p1": "k vrácení nájemci na účet <acct>",
    "label_pN": "K vrácení nájemci"
  },

  "summary": {
    "_schema_items": "[label, cost, paid, diff]; diff kladný = přeplatek nájemce; CELKEM se dopočítá",
