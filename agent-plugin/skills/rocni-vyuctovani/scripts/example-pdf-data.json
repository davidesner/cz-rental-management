          ["minus: Zaplacené zálohy", 0.00]
        ],
        "result_label": "PŘEPLATEK SLUŽBY",
        "result_amount": 0.00
      }
    },
    {
      "type": "electricity_monthly",
      "title": "LIST 2 – ELEKTŘINA (<provider> + solar)",
      "intro_paragraphs": [
        "Dodavatel: <provider>, sazba ...",
        "<b>Solar (FVE):</b> ..."
      ],
      "table_header": ["Měsíc", "Faktura", "kWh\nfakturováno", "kWh\nsolar",
                       "Dodavatel (Kč)", "Solar (Kč)", "Celkem (Kč)"],
