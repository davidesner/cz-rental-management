      "_schema_rows": "[month, date_human, amount, expected, diff, note]",
      "rows": [
        ["01/<YYYY>", "<dd. mm.>", 0.00, 0.00, 0.00, ""]
      ],
      "totals_label": "CELKEM",
      "_schema_extra_sections": "[heading, body]",
