{
  "name": "@esnerda/cz-rental-management-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Czech rental-management app — exposes property/contract/payment/cost-statement/reconciliation tools over stdio. Speaks to a rental-management REST backend.",
  "type": "module",
  "bin": {
    "cz-rental-management-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastmcp": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rental",
    "czech",
    "vyuctovani",
    "claude"
  ],
  "license": "MIT",
  "author": "David Esner <david@keboola.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidesner/cz-rental-management.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/davidesner/cz-rental-management/tree/main/mcp#readme",
  "bugs": "https://github.com/davidesner/cz-rental-management/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
